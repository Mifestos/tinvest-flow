# ==========================================
# T-Invest API (Sandbox)
# Получить токен: https://tinkoff.github.io/investAPI/token/
# ==========================================
TINKOFF_SANDBOX_TOKEN=your_token_here
TINKOFF_SANDBOX_ACCOUNT_ID=your_account_id_here

# ==========================================
# Kafka
# ==========================================
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_TRADES=raw_trades

# ==========================================
# MinIO (S3)
# ==========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze

# ==========================================
# PostgreSQL (DWH / Silver Layer)
# ==========================================
POSTGRES_DWH_HOST=localhost
POSTGRES_DWH_PORT=5432
POSTGRES_DWH_DB=dwh
POSTGRES_DWH_USER=dwh
POSTGRES_DWH_PASSWORD=dwh